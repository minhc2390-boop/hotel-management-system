<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" language="java" %><%@ page import="com.hotel.model.User" %><%@ page import="com.hotel.model.Room" %><%@ page import="java.text.NumberFormat" %><%@ page import="java.util.Locale" %>
<%
HttpSession sess=request.getSession(false);User currentUser=sess!=null?(User)sess.getAttribute("currentUser"):null;Room room=(Room)request.getAttribute("room");if(currentUser==null||room==null){response.sendRedirect(request.getContextPath()+"/login");return;}NumberFormat money=NumberFormat.getCurrencyInstance(new Locale("vi","VN"));
%>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Đặt phòng - Nestora</title><link rel="stylesheet" href="<%=request.getContextPath()%>/css/style.css"></head><body><header class="public-header"><div class="public-brand"><div class="brand-logo" aria-hidden="true"><img src="<%=request.getContextPath()%>/assets/icons/logo.svg" alt=""></div><div class="brand-name"><strong>NESTORA</strong><small>HOTEL MANAGER</small></div></div><nav class="public-nav"><a href="<%=request.getContextPath()%>/home">Trang chủ</a><a href="<%=request.getContextPath()%>/bills?action=mybills">Phòng đã đặt</a><a href="<%=request.getContextPath()%>/logout">Đăng xuất</a></nav></header>
<main class="public-content"><div class="page-head"><div><div class="breadcrumb">Trang chủ / Đặt phòng</div><h1 class="page-title">Xác nhận đặt phòng</h1><p class="page-desc">Kiểm tra thông tin phòng và chọn ngày lưu trú.</p></div></div><div class="checkout-grid"><section class="surface surface-pad"><h2 class="form-title">Thông tin phòng</h2><div class="checkout-room"><div class="checkout-line"><span>Số phòng</span><strong>Phòng <%=room.getRoomNumber()%></strong></div><div class="checkout-line"><span>Loại phòng</span><strong><%=room.getRoomType().getName()%></strong></div><div class="checkout-line"><span>Giá mỗi ngày</span><strong class="text-primary"><%=money.format(room.getRoomType().getPricePerDay())%></strong></div><div class="checkout-line"><span>Sức chứa</span><strong><%=room.getRoomType().getCapacity()%> người</strong></div><div class="checkout-line"><span>Mô tả</span><strong><%=room.getDescription()!=null?room.getDescription():room.getRoomType().getDescription()%></strong></div></div></section><section class="surface surface-pad"><h2 class="form-title">Thời gian lưu trú</h2><form action="<%=request.getContextPath()%>/bills" method="post" id="bookingForm"><input type="hidden" name="action" value="createBooking"><input type="hidden" name="roomId" value="<%=room.getId()%>"><div class="form-group"><label class="form-label" for="checkInDate">Ngày nhận phòng</label><input class="form-control" type="date" id="checkInDate" name="checkInDate" required></div><div class="form-group"><label class="form-label" for="checkOutDate">Ngày trả phòng</label><input class="form-control" type="date" id="checkOutDate" name="checkOutDate" required></div><div id="dateError" class="alert alert-error hidden">Ngày trả phòng phải sau ngày nhận phòng.</div><div class="checkout-line"><span>Tạm tính</span><strong id="estimatedTotal" class="checkout-total"><%=money.format(room.getRoomType().getPricePerDay())%></strong></div><div class="form-actions" style="margin-top:16px"><a class="btn btn-outline" href="<%=request.getContextPath()%>/home">Hủy</a><button class="btn btn-primary" type="submit">Xác nhận đặt phòng</button></div></form></section></div></main>
<script>const p=<%=room.getRoomType().getPricePerDay()%>,i=document.getElementById('checkInDate'),o=document.getElementById('checkOutDate'),t=document.getElementById('estimatedTotal'),e=document.getElementById('dateError');const f=d=>d.toISOString().slice(0,10);let n=new Date(),m=new Date(n);m.setDate(m.getDate()+1);i.value=f(n);i.min=f(n);o.value=f(m);o.min=f(m);function u(){let a=new Date(i.value),b=new Date(o.value),days=Math.ceil((b-a)/86400000);if(days<=0){e.classList.remove('hidden');return}e.classList.add('hidden');t.textContent=new Intl.NumberFormat('vi-VN',{style:'currency',currency:'VND'}).format(days*p)+' ('+days+' ngày)'}i.addEventListener('change',()=>{let a=new Date(i.value),b=new Date(a);b.setDate(b.getDate()+1);o.min=f(b);if(new Date(o.value)<=a)o.value=f(b);u()});o.addEventListener('change',u);</script></body></html>
