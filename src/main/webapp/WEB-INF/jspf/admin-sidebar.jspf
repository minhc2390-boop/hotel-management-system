<%@ page pageEncoding="UTF-8" %>
<style>
  /* Fix lỗi biến mất icon khi thu gọn menu (chống cache trình duyệt) */
  .sidebar-collapsed .nav-link span:not(.nav-icon) {
      display: none !important;
  }
  .sidebar-collapsed .nav-link span.nav-icon {
      display: inline-block !important;
  }
</style>
<aside class="sidebar">
  <div class="sidebar-head">
    <div class="brand">
      <div class="brand-logo" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 21V8l8-5 8 5v13"/><path d="M8 21v-7h8v7M8 10h.01M12 10h.01M16 10h.01"/></svg>
      </div>
      <div class="brand-name"><strong>NESTORA</strong><small>HOTEL MANAGER</small></div>
    </div>
  </div>

  <div class="sidebar-scroll">
    <div class="nav-section">
      <a class="nav-link <%= "dashboard".equals(activeMenu) ? "active" : "" %>" href="<%= request.getContextPath() %>/home">
        <span class="nav-icon exported-icon" style="--icon:url('<%= request.getContextPath() %>/assets/icons/dashboard.svg')" aria-hidden="true"></span>
        <span>Tổng quan</span>
      </a>
    </div>

    <div class="nav-section">
      <div class="nav-label">Vận hành</div>
      <a class="nav-link <%= "roomMap".equals(activeMenu) ? "active" : "" %>" href="<%= request.getContextPath() %>/rooms?action=map">
        <span class="nav-icon exported-icon" style="--icon:url('<%= request.getContextPath() %>/assets/icons/room-map.svg')" aria-hidden="true"></span>
        <span>Sơ đồ phòng</span>
      </a>
      <a class="nav-link <%= "rooms".equals(activeMenu) ? "active" : "" %>" href="<%= request.getContextPath() %>/rooms?action=list">
        <span class="nav-icon exported-icon" style="--icon:url('<%= request.getContextPath() %>/assets/icons/room-list.svg')" aria-hidden="true"></span>
        <span>Danh sách phòng</span>
      </a>
      <a class="nav-link <%= "roomTypes".equals(activeMenu) ? "active" : "" %>" href="<%= request.getContextPath() %>/roomtypes?action=list">
        <span class="nav-icon exported-icon" style="--icon:url('<%= request.getContextPath() %>/assets/icons/room-list.svg')" aria-hidden="true"></span>
        <span>Loại phòng</span>
      </a>
      <a class="nav-link <%= "equipments".equals(activeMenu) ? "active" : "" %>" href="<%= request.getContextPath() %>/equipments?action=list">
        <span class="nav-icon exported-icon" style="--icon:url('<%= request.getContextPath() %>/assets/icons/equipment.svg')" aria-hidden="true"></span>
        <span>Quản lý thiết bị</span>
      </a>
      <a class="nav-link <%= "customers".equals(activeMenu) ? "active" : "" %>" href="<%= request.getContextPath() %>/users?action=list">
        <span class="nav-icon exported-icon" style="--icon:url('<%= request.getContextPath() %>/assets/icons/customer.svg')" aria-hidden="true"></span>
        <span>Người dùng & Khách hàng</span>
      </a>
      <a class="nav-link <%= "bookings".equals(activeMenu) ? "active" : "" %>" href="<%= request.getContextPath() %>/bookings?action=list">
        <span class="nav-icon exported-icon" style="--icon:url('<%= request.getContextPath() %>/assets/icons/booking.svg')" aria-hidden="true"></span>
        <span>Đặt phòng</span>
      </a>
      <a class="nav-link <%= "services".equals(activeMenu) ? "active" : "" %>" href="<%= request.getContextPath() %>/services?action=list">
        <span class="nav-icon exported-icon" style="--icon:url('<%= request.getContextPath() %>/assets/icons/service.svg')" aria-hidden="true"></span>
        <span>Dịch vụ</span>
      </a>
      <a class="nav-link <%= "buffet".equals(activeMenu) ? "active" : "" %>" href="<%= request.getContextPath() %>/buffet?action=list">
        <span class="nav-icon exported-icon" style="--icon:url('<%= request.getContextPath() %>/assets/icons/service.svg')" aria-hidden="true"></span>
        <span>Menu Buffet</span>
      </a>
      <a class="nav-link <%= "feedbacks".equals(activeMenu) ? "active" : "" %>" href="<%= request.getContextPath() %>/feedbacks?action=list">
        <span class="nav-icon exported-icon" style="--icon:url('<%= request.getContextPath() %>/assets/icons/booking.svg')" aria-hidden="true"></span>
        <span>Đánh giá & Góp ý</span>
      </a>
    </div>

    <div class="nav-section">
      <div class="nav-label">Tài chính</div>
      <a class="nav-link <%= "bills".equals(activeMenu) ? "active" : "" %>" href="<%= request.getContextPath() %>/bills?action=list">
        <span class="nav-icon exported-icon" style="--icon:url('<%= request.getContextPath() %>/assets/icons/bill.svg')" aria-hidden="true"></span>
        <span>Hóa đơn</span>
      </a>
      <a class="nav-link <%= "profits".equals(activeMenu) ? "active" : "" %>" href="<%= request.getContextPath() %>/admin/profits.jsp">
        <span class="nav-icon exported-icon" style="--icon:url('<%= request.getContextPath() %>/assets/icons/revenue.svg')" aria-hidden="true"></span>
        <span>Doanh thu</span>
      </a>
    </div>

    <% if (currentUser != null && "Admin".equals(currentUser.getRole())) { %>
    <div class="nav-section">
      <div class="nav-label">Quản trị</div>
      <a class="nav-link <%= "employees".equals(activeMenu) ? "active" : "" %>" href="<%= request.getContextPath() %>/users?action=employees">
        <span class="nav-icon exported-icon" style="--icon:url('<%= request.getContextPath() %>/assets/icons/customer.svg')" aria-hidden="true"></span>
        <span>Nhân viên</span>
      </a>
    </div>
    <% } %>
  </div>

  <div class="sidebar-foot">
    <a class="nav-link" href="#" data-sidebar-collapse>
      <span class="nav-icon collapse-icon" aria-hidden="true">‹</span>
      <span>Thu gọn menu</span>
    </a>
    <a class="nav-link <%= "settings".equals(activeMenu) ? "active" : "" %>" href="<%= request.getContextPath() %>/admin/settings.jsp">
      <span class="nav-icon exported-icon" style="--icon:url('<%= request.getContextPath() %>/assets/icons/settings.svg')" aria-hidden="true"></span>
      <span>Cài đặt</span>
    </a>
    <a class="nav-link danger" href="<%= request.getContextPath() %>/logout">
      <span class="nav-icon exported-icon" style="--icon:url('<%= request.getContextPath() %>/assets/icons/logout.svg')" aria-hidden="true"></span>
      <span>Đăng xuất</span>
    </a>
  </div>
</aside>
