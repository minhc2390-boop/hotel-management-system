<%@ page pageEncoding="UTF-8" %>
<%
  String topName = (currentUser != null && currentUser.getFullName() != null) ? currentUser.getFullName() : "Ngọc Linh";
  String topRole = (currentUser != null && currentUser.getRole() != null) ? currentUser.getRole() : "Quản lý";
  String topInitial = topName.length() > 0 ? topName.substring(0, 1).toUpperCase() : "N";
%>
<header class="topbar">
  <div class="topbar-left">
    <button class="menu-toggle" type="button" data-sidebar-toggle aria-label="Mở menu">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>
    <div class="topbar-title"><strong>Hệ thống quản lý</strong><span><%= new java.text.SimpleDateFormat("EEEE, dd 'tháng' MM, yyyy", new java.util.Locale("vi", "VN")).format(new java.util.Date()) %></span></div>
  </div>
  <div class="topbar-actions">
    <div class="notification" aria-label="Thông báo"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4"/></svg></div>
    <div class="user-chip"><div class="avatar"><%= topInitial %></div><div class="user-meta"><strong><%= topName %></strong><span><%= topRole %></span></div></div>
  </div>
</header>
